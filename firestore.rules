service cloud.firestore {
  match /databases/{database}/documents {
    match /therapySessionNotes/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.therapistId;
      allow create, update: if
        request.resource.data.clientName is string &&
        request.resource.data.clientName.size() > 0 &&
        request.auth.uid == request.resource.data.therapistId;
    }
  }
} 